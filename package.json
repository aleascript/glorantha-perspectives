{
  "name": "glorantha-perspectives",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run start:fr",
    "start:fr": "docusaurus start --locale fr",
    "start:en": "docusaurus start --locale en",
    "preview": "docusaurus serve --build",
    "build": "docusaurus build",
    "build:fr": "docusaurus build --locale fr",
    "build:en": "docusaurus build --locale en",
    "publication:build": "node tools/run-publication-build.mjs",
    "publication:site": "node tools/copy-publications-to-site.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "check": "npm run typecheck && npm run build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.2.18",
    "@vivliostyle/cli": "^11.2.0",
    "typescript": "6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
