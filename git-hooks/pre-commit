#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CHANGED_ADCOS="$(git -C "$PROJECT_ROOT" diff --cached --name-only --diff-filter=ACMR -- 'srd/*.adoc')"
if [ -n "$CHANGED_ADCOS" ]; then
    for src in $CHANGED_ADCOS; do
        lang="$(basename "$src" | sed -E 's/^glorantha-perspectives-([a-z]{2})\.adoc$/\1/')"
        if [ "$lang" = "$(basename "$src")" ]; then
            echo "[pre-commit] Nom de fichier SRD non reconnu: $src" >&2
            continue
        fi
        echo "[pre-commit] Régénération du PDF SRD ($lang)..."
        bash "$PROJECT_ROOT/tools/generate-srd-pdf.sh" "$lang"
        git -C "$PROJECT_ROOT" add -- "content/${lang}/srd/"
    done
fi

STORY_SLUGS="la-voie-lunaire les-heritiers-de-zola-fel"
for slug in $STORY_SLUGS; do
    for lang in fr en; do
        CHANGED_STORY="$(git -C "$PROJECT_ROOT" diff --cached --name-only --diff-filter=ACMR \
            -- "content/${lang}/stories/${slug}/" "content/assets/stories/${slug}/" \
            | grep -v '\.pdf$' || true)"
        if [ -z "$CHANGED_STORY" ]; then
            continue
        fi
        echo "[pre-commit] Régénération du PDF de l'histoire ($slug, $lang)..."
        bash "$PROJECT_ROOT/tools/generate-story-pdf.sh" "$slug" "$lang"
        git -C "$PROJECT_ROOT" add -- "content/${lang}/stories/${slug}/${slug}.pdf"
    done
done
